# ClearedToGo — Flutter client environment (loaded via flutter_dotenv).
# Copy to `.env` and fill in real values. `.env` is gitignored.
#
# ONLY non-secret, client-safe values belong here. The Supabase anon
# (publishable) key is designed to be shipped in clients; it is still kept
# out of source control so the project ref isn't casually leaked.
#
# The service_role key and the AVWX token MUST NOT appear in this file or
# anywhere else the app can read — they live only in Supabase Edge Function
# secrets / the Node seed script environment.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLISHABLE-KEY
