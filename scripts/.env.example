# ClearedToGo — Node seed script environment.
# Copy to `scripts/.env` and fill in. `scripts/.env` is gitignored.
#
# The service_role key bypasses Row Level Security. Treat it like a password:
# never commit it, never put it in the Flutter app, never paste it anywhere
# client-reachable.

SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role JWT from Supabase project settings>

# Also required by verify_schema.mjs (same value the Flutter app's .env uses —
# this key is client-safe, unlike the service role key above):
SUPABASE_ANON_KEY=<anon/publishable key>

# Optional overrides (sensible defaults exist in seed_dev_user.mjs):
# SEED_PILOT_EMAIL=dev.pilot@clearedtogo.test
# SEED_ADMIN_EMAIL=dev.admin@clearedtogo.test
# SEED_SCHOOL_NAME=Dev Flight School

# Optional: real admin email for seed_devon_somerset_school.mjs. Without it,
# the script uses an obvious TODO_REPLACE_... placeholder.
# SEED_DEVON_ADMIN_EMAIL=

# Only needed by verify_schema.mjs, to sign in as each role and check RLS.
# Get these from the output of `node seed_dev_user.mjs` (run with --reset to
# get fresh ones if you didn't save them):
# DEV_PILOT_EMAIL=dev.pilot@clearedtogo.test
# DEV_PILOT_PASSWORD=
# DEV_ADMIN_EMAIL=dev.admin@clearedtogo.test
# DEV_ADMIN_PASSWORD=

# Optional: ICAO code verify_schema.mjs uses to test the get-weather Edge
# Function (default EGLL).
# AVWX_TEST_ICAO=EGLL
